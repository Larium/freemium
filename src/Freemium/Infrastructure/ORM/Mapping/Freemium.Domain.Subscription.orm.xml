<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Freemium\Domain\Subscription" table="subscriptions">
        <id name="token" type="string" column="token"/>
        <field name="inTrial" type="boolean" column="in_trial"/>
        <field name="daysTrial" type="integer" column="days_trial"/>
        <field name="daysGrace" type="integer" column="days_grace"/>
        <field name="paidThrough" type="date_immutable" column="paid_through" nullable="true"/>
        <field name="startedOn" type="date_immutable" column="started_on"/>
        <field name="lastTransactionAt" type="date_immutable" column="last_transaction_at" nullable="true"/>
        <field name="cancelAt" type="date_immutable" column="cancel_at" nullable="true"/>
        <field name="status" type="subscription_status" column="status"/>
        <embedded name="rate" class="Freemium\Domain\Money" column-prefix="rate_"/>
        <many-to-one field="subscribable" target-entity="Freemium\Domain\Customer">
            <join-column name="customer_id" referenced-column-name="customer_id" nullable="false"/>
        </many-to-one>
        <many-to-one field="subscriptionPlan" target-entity="Freemium\Domain\SubscriptionPlan">
            <join-column name="subscription_plan_token" referenced-column-name="token" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
