<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Freemium\Domain\CouponRedemption" table="coupon_redemptions">
        <id name="token" type="string" column="token"/>
        <field name="redeemedOn" type="date_immutable" column="redeemed_on"/>
        <field name="expiredOn" type="date_immutable" column="expired_on" nullable="true"/>
        <many-to-one field="subscription" target-entity="Freemium\Domain\Subscription">
            <join-column name="subscription_token" referenced-column-name="token" nullable="false"/>
        </many-to-one>
        <many-to-one field="coupon" target-entity="Freemium\Domain\Coupon">
            <join-column name="coupon_token" referenced-column-name="token" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
